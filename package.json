{
  "name": "whatsapp-baileys-mcp",
  "version": "1.0.0",
  "description": "MCP server for WhatsApp (Baileys): multi-session, SQLite persistence, full messaging/groups/chats/contacts toolset",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "whatsapp-baileys-mcp": "dist/index.js",
    "whatsapp-baileys-mcp-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "!dist/**/*.map",
    ".env.example"
  ],
  "keywords": ["mcp", "model-context-protocol", "whatsapp", "baileys", "claude"],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"dist/tests/*.test.js\"",
    "pair": "node dist/cli.js pair",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
