# Copy to .env (or pass as env in your MCP client config). All optional.

# Where SQLite DB, media and logs live (default: <project>/data)
WA_MCP_DATA_DIR=

# Reject every tool that sends / mutates WhatsApp state (1 = read only)
WA_MCP_READ_ONLY=0

# Reconnect every paired session on startup (default 1)
WA_MCP_AUTOCONNECT=1

# Ask WhatsApp for full history at pairing time (default 1)
WA_MCP_SYNC_FULL_HISTORY=1

# Auto download incoming media: off | all  (default all, up to WA_MCP_MEDIA_MAX_MB)
WA_MCP_AUTO_DOWNLOAD=all
WA_MCP_MEDIA_MAX_MB=16

# Anti-ban throttle per session
WA_MCP_SEND_DELAY_MS=700
WA_MCP_MAX_MSGS_PER_MIN=40

# Comma list of tool groups to expose: sessions,messages,read,contacts,chats,groups,business,memory,admin
# "lite" = sessions,messages,read,contacts,groups,memory (fewer tools = less context). Default: all
WA_MCP_TOOLSETS=

# HTTP transport (node dist/index.js --http)
WA_MCP_HTTP_HOST=127.0.0.1
WA_MCP_HTTP_PORT=3939
# Bearer token required by the HTTP transport. If empty, one is generated and stored in data/http-token
WA_MCP_HTTP_TOKEN=

# Claude Code channel push (experimental). Only JIDs / numbers listed here are pushed into the conversation.
WA_MCP_CHANNEL=0
WA_MCP_CHANNEL_ALLOW=

# Webhook: POST each matching event (owner process only) as JSON, at-least-once and in order
# (cursor in data/webhook-cursor; a receiver that was down catches up when it comes back)
# {source, type, from, from_name, text, has_media, reply:{channel,session,to}, dedupe_key, ts, raw}
WA_MCP_WEBHOOK_URL=
# Sent as "Authorization: Bearer <token>"
WA_MCP_WEBHOOK_TOKEN=
# Comma list of event types to forward (default message.in)
WA_MCP_WEBHOOK_EVENTS=
# Also forward group messages (default 0)
WA_MCP_WEBHOOK_GROUPS=0
# Forward only these groups (comma list of group ids, e.g. 120363…@g.us), even when WEBHOOK_GROUPS=0
WA_MCP_WEBHOOK_GROUP_ALLOW=
# Only forward these senders (comma list of phones). Empty = everyone. Filtered at the source: nothing else leaves the process.
WA_MCP_WEBHOOK_ALLOW=

# Pino level for the log file / stderr: trace|debug|info|warn|error|silent
WA_MCP_LOG_LEVEL=info

# Restrict local files that tools may send/read to these directories (comma list). Default: any non-sensitive path
WA_MCP_ALLOWED_DIRS=
# Allow tools to fetch URLs that resolve to private / loopback addresses (default 0 = blocked, SSRF protection)
WA_MCP_ALLOW_PRIVATE_URLS=0
# Automatically reject incoming calls
WA_MCP_REJECT_CALLS=0

# Refuse to send when the other side wrote something new since the agent last read the chat (default 1)
WA_MCP_FRESHNESS_GUARD=1
